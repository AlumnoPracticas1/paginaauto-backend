# ===== LOCAL (WAMP) =====
PORT=4000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=paginaauto

# Pipeline IA (main.py FastAPI) — solo local
PYTHON_API=http://localhost:8000
PHP_CODE_ROOT=C:/wamp64/www/backendstore
JS_CODE_ROOT=C:/Users/Lenovo/Desktop/HAM/Pagina web

# ===== CLOUD (Railway) =====
# Si DATABASE_URL existe, db.js la usa en vez de DB_HOST/DB_USER/...
# En Railway: Variables → Add Reference → ${{ MySQL.MYSQL_URL }}
# DATABASE_URL=mysql://user:pass@host:3306/railway

# CORS — URL publica del frontend en Vercel (coma-separadas si hay varias)
# ALLOWED_ORIGINS=https://paginaauto-frontend.vercel.app

# github-app (servicio aparte en Railway, opcional)
# GITHUB_PROXY_URL=https://paginaauto-gh.up.railway.app
# GITHUB_PROXY_INTERNAL_TOKEN=cadena-aleatoria-larga

# Catalogo de repos GitHub manejados
# APP_REPOS_JSON={"avantservice":{"owner":"AlumnoPracticas1","repo":"testdepagina","branch":"main"}}
